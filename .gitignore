# JavaScript
node_modules/
.next/
npm-debug.log*

# Local environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# XcodeGen output (regenerate with `xcodegen generate` in apps/ios and apps/visionos)
apps/ios/*.xcodeproj
apps/visionos/*.xcodeproj
apps/ios/Generated/

# Swift Package Manager build output
.build/
packages/**/.build/

# macOS
.DS_Store

# Cloudflare Wrangler local state (local D1 database, cache)
.wrangler/

# Local-only reference images
apps/images/
apps/web/public/collection/

# Next.js 16 `next dev` auto-generates these
apps/web/AGENTS.md
apps/web/CLAUDE.md
apps/web/tsconfig.tsbuildinfo

# Local runtime data (redemptions, passports); never commit
.data/
**/.data/

# Landing media. The two real-device recordings the landing shows (hero-demo, ios-demo) and their poster frames are
# committed: the one exception to "no card images in the repo". Everything else
# in this folder (unused clips, source footage) stays out. The page falls back to drawn placeholders when a file is missing.
apps/web/public/lp/*
!apps/web/public/lp/hero-demo.mp4
!apps/web/public/lp/hero-demo.jpg
!apps/web/public/lp/ios-demo.mp4
!apps/web/public/lp/ios-demo.jpg
