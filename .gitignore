# JavaScript
node_modules/
.next/
npm-debug.log*

# Local environment variables and secrets
.env
.env.*
!.env.example
!**/.env.example

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# XcodeGen output (regenerate with `xcodegen generate` in apps/ios and apps/visionos)
apps/ios/*.xcodeproj
apps/visionos/*.xcodeproj
apps/ios/Generated/

# Swift Package Manager build output
.build/
packages/**/.build/

# macOS
.DS_Store

# Cloudflare Wrangler local state (local D1 database, cache)
.wrangler/

# Rights-unverified third-party reference images (local only; see AGENTS.md)
apps/images/
apps/web/public/collection/

# Next.js 16 `next dev` auto-generates these; the canonical guide is the repo-root AGENTS.md
apps/web/AGENTS.md
apps/web/CLAUDE.md
apps/web/tsconfig.tsbuildinfo

# Local runtime data (redemptions, passports); never commit
.data/
**/.data/
