# Copy this file to `.env.local` and fill in the real value locally.
# Never commit the real API key.
HELIUS_API_KEY=
SOLANA_NETWORK=devnet

# Maps Twinfold's internal stable asset id to its Solana devnet Asset
# address, so the address can be swapped in after a real mint without a
# code change. JSON object, e.g.:
# SOLANA_ASSET_ADDRESSES={"tf-ukiyoe-001":"<address>"}
# See .claude/skills/solana-devnet/SKILL.md and scripts/solana/.
SOLANA_ASSET_ADDRESSES=

# DEV-ONLY SHORTCUT. Set to 1 to allow POST /api/devnet/transfer to sign
# devnet transfers itself using the owner-a/owner-b/vault test wallet
# secret keys under ~/.config/twinfold/devnet/ (generated by
# `cd scripts/solana && npm run wallets:generate`). This stands in for real
# wallet signing (Issue #19/#45) and is refused outright when
# NODE_ENV=production or SOLANA_NETWORK isn't devnet, regardless of this
# flag. Leave unset/0 unless you are testing the "Twinfoldに売る" buyback or
# P2P transfer flow locally. See lib/solana/devnetSigningGuard.ts.
# It is ALSO required (=1) for owner-approved transfers (the Twinfold vault wallet is the fee payer)
# and for "Twinfoldから取得" acquisitions (the vault wallet signs). Without it those return 403.
TWINFOLD_DEVNET_SERVER_SIGNING=0

# Server-only HMAC secret for the wallet-signature session cookie (#19).
# Generate locally, e.g. `openssl rand -base64 32`. Never NEXT_PUBLIC_, never commit a value.
TWINFOLD_SESSION_SECRET=

# INSECURE, LOCAL-TESTING ONLY. Set to 1 to let POST /api/devnet/transfer (and its
# status route) run WITHOUT a web session or device token. Issue #45 closed that
# hole (owner-only); this deliberately reopens it. Default off; refused when
# NODE_ENV=production. Normal flow: link the iPhone from /collection instead.
TWINFOLD_DEVNET_ALLOW_UNAUTHENTICATED_TRANSFER=0

# Test-only: shorten the 2-minute iPhone link-code TTL (ms, min 100) so
# scripts/link-smoke.mjs can observe expiry. Ignored in production. Leave unset normally.
# TWINFOLD_LINK_CODE_TTL_MS=

# Redeem dry run (Issues #22/#23/#28/#42). Operator steps (ship / exception / retry_retire) are guarded by
# the dev server-signing flag above AND by this shared secret, sent as the `x-twinfold-operator-token` header
# (compared in constant time). Generate locally, e.g. `openssl rand -base64 32`. Server-only: never
# NEXT_PUBLIC_, never commit a value. Unset = operator actions are refused.
TWINFOLD_OPERATOR_TOKEN=

# Redeem escrow wallet: generated with the other devnet wallets by `cd scripts/solana && npm run wallets:generate`
# (~/.config/twinfold/devnet/escrow.json). Redemptions and Passports are persisted under apps/web/.data/
# (gitignored); override the directory with TWINFOLD_DATA_DIR if needed.
# TWINFOLD_DATA_DIR=
