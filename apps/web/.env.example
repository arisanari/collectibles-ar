# Copy this file to `.env.local` and fill in the real value locally.
# Never commit the real API key.
HELIUS_API_KEY=
SOLANA_NETWORK=devnet

# Maps Twinfold's internal stable asset id to its Solana devnet Asset
# address, so the address can be swapped in after a real mint without a
# code change. JSON object, e.g.:
# SOLANA_ASSET_ADDRESSES={"tf-ukiyoe-001":"<address>"}
# See .claude/skills/solana-devnet/SKILL.md and scripts/solana/.
SOLANA_ASSET_ADDRESSES=

# DEV-ONLY SHORTCUT. Set to 1 to allow POST /api/devnet/transfer to sign
# devnet transfers itself using the owner-a/owner-b/vault test wallet
# secret keys under ~/.config/twinfold/devnet/ (generated by
# `cd scripts/solana && npm run wallets:generate`). This stands in for real
# wallet signing (Issue #19/#45) and is refused outright when
# NODE_ENV=production or SOLANA_NETWORK isn't devnet, regardless of this
# flag. Leave unset/0 unless you are testing the "Twinfoldに売る" buyback or
# P2P transfer flow locally. See lib/solana/devnetSigningGuard.ts.
# It is ALSO required (=1) for owner-approved transfers (the Twinfold vault wallet is the fee payer)
# and for "Twinfoldから取得" acquisitions (the vault wallet signs). Without it those return 403.
TWINFOLD_DEVNET_SERVER_SIGNING=0

# Server-only HMAC secret for the wallet-signature session cookie (#19).
# Generate locally, e.g. `openssl rand -base64 32`. Never NEXT_PUBLIC_, never commit a value.
TWINFOLD_SESSION_SECRET=

# INSECURE, LOCAL-TESTING ONLY. Set to 1 to let POST /api/devnet/transfer (and its
# status route) run WITHOUT a web session or device token. Issue #45 closed that
# hole (owner-only); this deliberately reopens it. Default off; refused when
# NODE_ENV=production. Normal flow: link the iPhone from /collection instead.
TWINFOLD_DEVNET_ALLOW_UNAUTHENTICATED_TRANSFER=0

# Test-only: shorten the 2-minute iPhone link-code TTL (ms, min 100) so
# scripts/link-smoke.mjs can observe expiry. Ignored in production. Leave unset normally.
# TWINFOLD_LINK_CODE_TTL_MS=

# Redeem dry run (Issues #22/#23/#28/#42). Operator steps (ship / exception / retry_retire) are guarded by
# the dev server-signing flag above AND by this shared secret, sent as the `x-twinfold-operator-token` header
# (compared in constant time). Generate locally, e.g. `openssl rand -base64 32`. Server-only: never
# NEXT_PUBLIC_, never commit a value. Unset = operator actions are refused.
TWINFOLD_OPERATOR_TOKEN=

# Redeem escrow wallet: generated with the other devnet wallets by `cd scripts/solana && npm run wallets:generate`
# (~/.config/twinfold/devnet/escrow.json). Redemptions and Passports are persisted under apps/web/.data/
# (gitignored); override the directory with TWINFOLD_DATA_DIR if needed.
# TWINFOLD_DATA_DIR=

# Collectibles AR / Collector Crypt Gacha (devnet). Server-only: never NEXT_PUBLIC_, never commit a value.
# Base URL of the gacha API. Default is the devnet host; any other host except localhost is refused (no mainnet).
COLLECTOR_CRYPT_GACHA_BASE_URL=https://dev-gacha.collectorcrypt.com
# Optional. Sent as `x-api-key`; it only tags the Pull memo with our slug. Everything works without it.
COLLECTOR_CRYPT_API_KEY=
# Comma separated DAS collection addresses that count as Collector Crypt issued, one variable per network (never mixed).
# An asset gets source "collectorCrypt" only when its DAS grouping (collection) matches one of these. A card that merely
# has the attributes "Grading Company" + "Vault ID" is still listed, but marked UNVERIFIED SOURCE and kept out of the AR list.
# Found with Helius DAS getAsset (public addresses, not secrets):
#   Core cards (MplCoreAsset): CCryptUfeFSZ3Fgc9FLeKrhLVAP67FSqi1GuVoj9CRac. The same collection address is used on
#            devnet and mainnet (mainnet: mint 5JXdT3VWDq4gBdCyoUkkcYmZUB44zfAdGzELcA8Zh6ER, a public pokemon_25 pool card;
#            devnet: a card drawn in this app, mint BH1i9EpP...).
#   pNFT cards (ProgrammableNFT): CCryptWBYktukHDQ2vHGtVcmtjXxYzvw8XNVY64YN2Yf (devnet pokemon_25 pool cards, symbol COLLECTOR).
# So devnet needs BOTH, comma separated. Mainnet: only the Core collection was seen; add others here when seen.
# A card drawn through this app's own openPack is also verified by the local Pull record, whatever its collection.
# To enable, copy into .env.local:
# COLLECTOR_CRYPT_COLLECTION_ADDRESSES_DEVNET=CCryptUfeFSZ3Fgc9FLeKrhLVAP67FSqi1GuVoj9CRac,CCryptWBYktukHDQ2vHGtVcmtjXxYzvw8XNVY64YN2Yf
# COLLECTOR_CRYPT_COLLECTION_ADDRESSES_MAINNET=CCryptUfeFSZ3Fgc9FLeKrhLVAP67FSqi1GuVoj9CRac
COLLECTOR_CRYPT_COLLECTION_ADDRESSES_DEVNET=
# MAINNET is READ-ONLY. GET /api/solana/assets?wallet=<addr>&network=mainnet reads the wallet's cards through Helius
# MAINNET DAS (https://mainnet.helius-rpc.com, same HELIUS_API_KEY, server-side only) and returns ONLY assets whose collection is
# listed here (category "card", source "collectorCrypt", sourceVerified true, network "mainnet"). Empty = nothing is
# returned on mainnet; a card with just the right attributes never qualifies. The response is cached 60 seconds on the
# server. Every write route (Pull, buyback, transfer, redeem, ...) answers 400 to network=mainnet: the app never signs
# or sends anything on mainnet. Real packs are pulled on gacha.collectorcrypt.com.
COLLECTOR_CRYPT_COLLECTION_ADDRESSES_MAINNET=
# Optional. "mock" makes every /api/gacha/* route serve DEMO DATA (no Collector Crypt call).
# GACHA_PROVIDER=mock

# Optional. The /pull/lab prototype pages (opening effect, DEMO DATA only) answer 404 in a production build.
# Set LAB_PAGES=1 only when you want them served there. Server-side only: never NEXT_PUBLIC_.
# LAB_PAGES=

# --- Public landing (all NEXT_PUBLIC_: these are not secrets and are read in the browser) ---
# Canonical site address, used for share-image and canonical URLs. Default: https://collectiblesar.com
NEXT_PUBLIC_SITE_URL=
# 1 = the header shows the brand and Pull only (no sign-in, no My collection). Use on the public landing deploy.
NEXT_PUBLIC_LP_ONLY=
# 1 = the Pull buttons on / and /pull start a real devnet Pull. Unset = they show "Opening soon".
NEXT_PUBLIC_PULL_OPEN=
# Install link for the iPhone app (TestFlight or App Store). Unset = the iOS buttons show "Beta test" and do nothing.
NEXT_PUBLIC_IOS_APP_URL=
# Optional overrides for the landing media. Unset = the files committed under public/lp/.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_LP_MEDIA_BASE=
